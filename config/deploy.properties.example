# Copy this file to config/deploy.properties and fill real environment values.
# This file is sourced by scripts/deploy.sh, so keep KEY=value shell syntax.

# Java and Maven
JAVA_BIN=java
MAVEN_BIN=mvn
JAVA_OPTS=

# Local Java process ports.
A2A_PORT=8080
VERSATILE_ADAPTER_PORT=8081

# Redis used by a2a_service task/session state and agent-core-java checkpointing.
# Set REDIS_START_MODE=docker only if this host has docker and should start a local redis container.
# For real environments, keep REDIS_START_MODE=external and point REDIS_HOST/PORT to the managed Redis.
REDIS_START_MODE=external
REDIS_DOCKER_IMAGE=redis:7
REDIS_DOCKER_NAME=edp-redis
REDIS_HOST=REDIS_HOST_OR_IP
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=1800
DPA_REDIS_CHECKPOINTER_TTL_MINUTES=60

# VersatileAdapter -> real Versatile workflow endpoint. This is usually a remote service.
# Keep the {conversation_id} placeholder in the URL.
VERSATILE_URL_TEMPLATE=http://REAL_VERSATILE_HOST/v1/PROJECT_ID/agents/AGENT_ID/conversations/{conversation_id}
VERSATILE_TIMEOUT=600

# a2a_service -> VersatileAdapter A2A endpoint.
# If both Java processes are deployed on the same host, keep localhost.
# If versatile_adapter is deployed separately, set this to its reachable host.
VERSATILE_ADAPTER_URL=http://127.0.0.1:8081/

# Default aligns with Python implementation. Adjust it if the real Versatile QA node_name differs.
VA_WORKFLOW_RESULT_NODE=GXZQAResponseNode

# EDPAgent LLM configuration.
LLM_PROVIDER=OpenAI
LLM_API_BASE=http://113.46.219.251:8080/v1
LLM_MODEL_NAME=Qwen3.6-Plus
LLM_API_KEY=
LLM_VERIFY_SSL=false
LLM_TIMEOUT=120
LLM_TOKEN=
LLM_TOKEN_HEADER=
LLM_USER_ID=
LLM_USER_ID_HEADER=
# Optional Spring Boot map binding for custom LLM headers.
# Example:
# LLM_EXTRA_HEADER_ARGS=(
#   '--dpa.llm-extra-headers.X-Custom-Token=token-value'
#   '--dpa.llm-extra-headers.X-User-Id=user-id'
# )
LLM_EXTRA_HEADER_ARGS=()

# Optional MCP configuration. Required only for MCP-first finance recommendation.
MCP_XSQ_URL=
MCP_JD_URL=
MCP_ACCESS_TOKEN=
MCP_APP_NAME=
MCP_TIMEOUT=25

# Rate limit. Use larger limits for manual integration testing.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=10
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=10

# Probe request values.
PROBE_HOST=127.0.0.1
PROBE_PROJECT_ID=demo
PROBE_AGENT_ID=edp_agent
PROBE_CONVERSATION_ID=c-probe

# Invoke request defaults.
INVOKE_HOST=127.0.0.1
INVOKE_PROJECT_ID=demo
INVOKE_AGENT_ID=edp_agent
INVOKE_STREAM=true
