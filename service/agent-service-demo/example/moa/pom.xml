<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openjiuwen</groupId>
        <artifactId>agent-service</artifactId>
        <version>${revision}</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>agent-service-demo-moa</artifactId>
    <packaging>jar</packaging>

    <name>agent-service-demo-moa</name>
    <description>MOA travel demo with a zero-LLM smoke test, ported from agent-solution common/agents/moa-agent-demo</description>

    <properties>
        <!-- MOA library comes from the agent-solution repo build, not from this reactor.
             Prerequisite before building this module:
             cd agent-solution-main &amp;&amp; mvn install -pl common/agents/moa-agent -am -DskipTests -->
        <moa-agent.version>0.1.3</moa-agent.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>moa-agent</artifactId>
            <version>${moa-agent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.moaagent.demo.MoaAgentDemoApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
